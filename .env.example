# ============================================================
# ENVIRONMENT VARIABLES - JobPilot Marketing Agents
# ============================================================
# Copy this file to .env and fill in your values

# ---- Core Database ----
# Local development uses SQLite; production uses Turso
DATABASE_URL="file:./dev.db"

# ---- Admin Dashboard ----
# Password to access the admin dashboard at /dashboard
# Generate a strong password for production
ADMIN_PASSWORD="changeme"

# ---- OAuth & Security ----
# # Random 32+ character string for signing OAuth state parameters
# # Generate with: openssl rand -hex 16 (or any secure random source)
OAUTH_STATE_SECRET=""

# ---- Email & Funnel Integration ----
# # Required for email sequences and funnel tracking

# RESEND_API_KEY: API key from Resend (resend.com)
# # Enables email sending via Resend SMTP service
# # Get from: https://dashboard.resend.com/api-keys
RESEND_API_KEY=""

# RESEND_WEBHOOK_SECRET: Webhook signing secret from Resend dashboard
# # Used to verify incoming webhook events are authentic
# # Get from: https://dashboard.resend.com/webhooks
RESEND_WEBHOOK_SECRET=""

# UNSUBSCRIBE_SECRET: Random 32+ character HMAC key
# # Used to sign/verify one-click unsubscribe tokens in emails
# # Generate with: openssl rand -hex 16
# # MUST be different from OAUTH_STATE_SECRET
UNSUBSCRIBE_SECRET=""

# CRON_SECRET: Random 32+ character bearer token
# # Protects cron-triggered routes (/api/email/send, /api/funnel/sync)
# # Vercel Cron passes this as Authorization: Bearer <CRON_SECRET>
# # Generate with: openssl rand -hex 16
CRON_SECRET=""

# JOBPILOT_API_URL: Base URL of the main JobPilot application
# # Used to fetch funnel events from the main app
# # Development: http://localhost:3000
# # Production: https://jobpilotai.co
JOBPILOT_API_URL="https://jobpilotai.co"

# JOBPILOT_API_SECRET: Shared secret for inter-service authentication
# # Must match INTERNAL_API_SECRET on the main app (jobpilot-website)
# # Used in the Authorization: Bearer header when calling /api/internal/funnel-events
# # Generate a random 32+ character string
# # Keep this synchronized across both apps!
JOBPILOT_API_SECRET=""

# ---- Media & AI Providers ----
# Gemini API key (same as used in main JobPilot app)
GEMINI_API_KEY=""

# Pexels API key (pexels.com/api) — B-roll video backgrounds for reels
PEXELS_API_KEY=""

# ElevenLabs API key (elevenlabs.io) — AI voiceover for reels
ELEVENLABS_API_KEY=""

# Pixabay API key (pixabay.com/api) — Royalty-free background music for reels
PIXABAY_API_KEY=""

# ---- Social Media Credentials ----
# Set these up as you connect each platform

# LinkedIn (developer.linkedin.com)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_ACCESS_TOKEN=""

# X / Twitter (developer.x.com)
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_SECRET=""

# Instagram (developers.facebook.com)
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""

# TikTok (developers.tiktok.com)
TIKTOK_ACCESS_TOKEN=""
