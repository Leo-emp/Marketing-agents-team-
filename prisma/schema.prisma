// ============================================================
// PRISMA SCHEMA - JobPilot Marketing Agents
// ============================================================
// Content queue for AI-generated social media posts.
// Each record is created by an AI agent, reviewed by admin,
// then auto-posted to the target platform.
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---- Marketing Content Queue ----
// Each row is one piece of content created by an AI agent
model Content {
  id             String    @id @default(cuid())
  agent          String                            // Which agent persona created it
  platform       String                            // linkedin, twitter, instagram, tiktok
  contentType    String                            // post, thread, reel_script, carousel, single_image, plain_text
  title          String                            // Internal label (not published)
  body           String                            // The actual post content
  captionText    String?                           // Separate caption for image/carousel posts
  hashtags       String?                           // Comma-separated hashtags
  mediaPrompt    String?                           // AI description for visual asset creation
  hook           String?                           // First line / scroll-stopper (for preview)
  status         String    @default("pending")     // pending, approved, scheduled, posted, rejected
  scheduledFor   DateTime?                         // When to auto-post
  postedAt       DateTime?                         // When it was actually posted
  platformPostId String?                           // ID returned by the platform after posting
  notes          String?                           // Admin feedback or edit notes
  researchBrief  String?                           // JSON: research data used for this content
  visualData     String?                           // JSON: structured SlideData[] or ReelConfig for visual generation
  imageUrl       String?                           // URL/path to generated image(s)
  videoUrl       String?                           // S3 URL of rendered video (reels)
  videoRenderId  String?                           // Remotion Lambda render ID for progress polling
  // # Editorial review fields — second-pass AI quality check
  editorialScore    Float?                         // 1-10 score from editorial review agent
  editorialFeedback String?                        // Specific feedback: what was fixed, what passed
  // # A/B variation tracking — groups variations for performance comparison
  variationGroup String?                           // Shared ID linking A/B variations together
  // # Engagement metrics — populated after posting for feedback loop
  engagementLikes       Int?                       // Likes/reactions count
  engagementComments    Int?                       // Comments count
  engagementShares      Int?                       // Shares/reposts count
  engagementSaves       Int?                       // Saves/bookmarks count
  engagementImpressions Int?                       // Total impressions/views
  engagementScore       Float?                     // Computed composite score for ranking
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([platform])
  @@index([scheduledFor])
  @@index([variationGroup])
  @@index([engagementScore])
}

// ---- Content Plans ----
// Weekly content calendar generated by the strategist agent
model ContentPlan {
  id        String   @id @default(cuid())
  weekOf    String                               // ISO date string for the week start
  plan      String                               // JSON array of planned content items
  status    String   @default("draft")           // draft, active, completed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---- Platform Credentials ----
// Stores OAuth tokens for social media platforms
// Encrypted at rest in production
model PlatformCredential {
  id           String   @id @default(cuid())
  platform     String   @unique                  // linkedin, twitter, instagram, tiktok
  accessToken  String                            // OAuth access token
  refreshToken String?                           // OAuth refresh token (if applicable)
  expiresAt    DateTime?                         // Token expiration
  metadata     String?                           // JSON blob for platform-specific data
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---- Generated Visuals ----
// Stores template data for rendered images (carousels, single images, storyboard frames)
model Visual {
  id         String   @id @default(cuid())
  contentId  String?                             // Links to a Content item
  type       String                              // single_image, carousel_slide, storyboard_frame
  slideIndex Int      @default(0)                // Slide position for carousels/storyboards
  templateId String                              // Which template layout was used
  data       String                              // JSON: all text, colors, layout data
  width      Int      @default(1080)
  height     Int      @default(1080)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([contentId])
}

// ---- KPI Metrics ----
// Tracks performance data across platforms
model KpiMetric {
  id         String   @id @default(cuid())
  platform   String                              // linkedin, twitter, instagram, tiktok
  contentId  String?                             // Links to specific content (optional)
  metricType String                              // impressions, reach, engagement, clicks, followers, saves, shares
  value      Float
  date       String                              // ISO date string
  source     String   @default("manual")         // manual, api
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([platform])
  @@index([date])
  @@index([contentId])
}

// ---- KPI Goals ----
// Targets for measuring brand performance
model KpiGoal {
  id          String   @id @default(cuid())
  platform    String                             // linkedin, twitter, instagram, tiktok, all
  metricType  String                             // impressions, reach, engagement, clicks, followers
  targetValue Float
  period      String                             // weekly, monthly, quarterly
  startDate   String                             // ISO date string
  endDate     String                             // ISO date string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- Email Nurture Sequences ----
// # Automated email campaigns triggered by user lifecycle events
// # Links to EmailSend for each email dispatch
model EmailSequence {
  id          String   @id @default(cuid())
  name        String                              // "Welcome Series", "Free-to-Pro Drip"
  description String?
  trigger     String                              // signup, high_usage_free, plan_upgrade
  priority    Int      @default(5)                // # Higher = wins when frequency cap hit
  status      String   @default("draft")          // # draft, active, paused
  steps       String                              // # JSON: [{ delayDays, subject, bodyTemplate, ctaUrl, ctaText }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sends       EmailSend[]                         // # Relation to EmailSend records

  @@index([trigger])
  @@index([status])
}

// ---- Email Send Log ----
// # Every email sent, with delivery/open/click tracking via Resend webhooks
// # Records the outcome of each email in the sequence for analytics
model EmailSend {
  id              String    @id @default(cuid())
  sequenceId      String
  stepIndex       Int                             // # Which step in the sequence (0-based)
  recipientEmail  String
  recipientUserId String?                         // # Main app user ID
  subject         String
  status          String    @default("queued")    // # queued, sent, delivered, opened, clicked, bounced, failed
  resendMessageId String?                         // # Resend API message ID
  utmSource       String?                         // # Auto-tagged: email
  utmMedium       String?                         // # Auto-tagged: nurture
  utmCampaign     String?                         // # Auto-tagged: sequence slug
  sentAt          DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  createdAt       DateTime  @default(now())

  sequence EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade) // # Relation back with cascade delete

  @@index([recipientEmail])
  @@index([recipientUserId])
  @@index([sequenceId])
  @@index([status])
  @@index([sentAt])
}

// ---- Email Preferences ----
// # Tracks unsubscribe status per user (permanent opt-out)
// # Used to respect user preferences before sending any email
model EmailPreference {
  id              String    @id @default(cuid())
  userId          String    @unique               // # Main app user ID
  email           String
  unsubscribedAt  DateTime?                       // # Null = subscribed
  reason          String?                         // # Optional unsubscribe reason
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
}

// ---- Funnel Events ----
// # User lifecycle events polled from the main app for attribution tracking
// # Captures signup, feature usage, upgrades, and utm params for analytics
model FunnelEvent {
  id          String   @id @default(cuid())
  userId      String                              // # Main app user ID
  email       String?
  eventType   String                              // # signup, first_ai_use, fifth_ai_use, pro_upgrade
  utmSource   String?                             // # twitter, linkedin, blog, email, reddit, extension, direct
  utmMedium   String?                             // # social, organic, nurture, cpc
  utmCampaign String?                             // # Specific campaign name
  utmTerm     String?                             // # Keyword (for paid)
  utmContent  String?                             // # A/B variant
  metadata    String?                             // # JSON: { feature, planAmount, etc. }
  eventDate   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([userId, eventType])
  @@index([eventType])
  @@index([utmSource])
  @@index([eventDate])
}
